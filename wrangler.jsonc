{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volebni-tipovacka",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "volebni-tipovacka",
      // Replaced with the real ID once the production database exists.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/2 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    // Tips lock when polling stations open; results are imported once they close.
    "DEADLINE": "2026-10-09T12:00:00Z",
    "POLLS_CLOSE": "2026-10-10T12:00:00Z",
    "RESULTS_UNTIL": "2026-10-19T00:00:00Z",
    "RESULTS_BASE_URL": "https://volby.gov.cz/appdata",
    "RESULTS_BATCH": "15",
    "MAIL_FROM": "",
    "TURNSTILE_SITE_KEY": ""
  }
}
